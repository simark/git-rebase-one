#!/usr/bin/env bash

set -e

section_break() {
  printf '\n%s\n' "============================================================"
}

print_commit() {
  git show --oneline --no-patch "$1"
}

if [ $# -lt 1 ]; then
  echo "Expecting at least one argument, the branch to rebase onto."
  exit 1
fi

target_ref="$1"
shift

n=1

if [ $# -ge 1 ]; then
  n=$1
  shift
fi


if [ $# -ge 1 ]; then
  echo "Unexpected extra arguments: $*"
  exit 11
fi

echo "Using jumps of $n commit(s)"

# Find merge base of current HEAD and target branch.
merge_base=$(git merge-base HEAD "${target_ref}")

num_commits=$(git rev-list --reverse "${merge_base}..${target_ref}" | wc -l)

if [ "${num_commits}" -eq 0 ]; then
  echo "Up to date"
  exit 12
fi

# Find first commit after merge base on the target branch.
first_commit=$(git rev-list --reverse "${merge_base}..${target_ref}" | head -n 1)
next_commit=$(git rev-list --reverse "${merge_base}..${target_ref}" | head -n "$n" | tail -n 1)

section_break
echo "Rebase step"
echo "  Remaining upstream commits: ${num_commits}"
echo "  Requested step size: ${n}"
echo "  Last successful upstream commit:"
echo "    $(print_commit "${merge_base}")"
if [ "${first_commit}" = "${next_commit}" ]; then
  echo "  Rebasing against upstream commit:"
  echo "    $(print_commit "${next_commit}")"
else
  echo "  Rebasing across upstream commits:"
  echo "    first: $(print_commit "${first_commit}")"
  echo "    last:  $(print_commit "${next_commit}")"
fi
section_break

# Rebase on that commit.
if ! git rebase "${next_commit}"; then
  section_break
  echo "Manual intervention required"
  echo "  Last successful upstream commit:"
  echo "    $(print_commit "${merge_base}")"
  if [ "${first_commit}" = "${next_commit}" ]; then
    echo "  Conflicting upstream commit:"
    echo "    $(print_commit "${next_commit}")"
  else
    echo "  This rebase attempt covered upstream commits:"
    echo "    first: $(print_commit "${first_commit}")"
    echo "    last:  $(print_commit "${next_commit}")"
    echo "  The exact conflicting upstream commit is within that range."
  fi
  section_break
  exit 13
fi
