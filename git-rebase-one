#!/usr/bin/env bash

set -e

section_break() {
  printf '\n%s\n' "============================================================"
}

print_commit() {
  git show --oneline --no-patch "$1"
}

# If the given commit is a merge, print the commits it brings in, i.e. those
# reachable from its non-first parents but not from its first parent.  Returns
# non-zero (without printing) if the commit is not a merge.
print_merge_brings_in() {
  local commit="$1"
  local parents
  parents=($(git rev-parse "${commit}^@"))
  if [ "${#parents[@]}" -lt 2 ]; then
    return 1
  fi
  git log --oneline "${parents[@]:1}" --not "${parents[0]}" | sed 's/^/    /'
}

# Sounds played on exit when the corresponding option is enabled.
SOUND_DIR=/usr/share/sounds/freedesktop/stereo
SUCCESS_SOUND="${SOUND_DIR}/complete.oga"
FAILURE_SOUND="${SOUND_DIR}/dialog-error.oga"

# Play a sound file, using whichever player is available.  Best-effort: never
# fail the script because of audio.
play_sound() {
  local file="$1"
  [ -r "${file}" ] || return 0
  if command -v pw-play >/dev/null 2>&1; then
    pw-play "${file}" >/dev/null 2>&1 || true
  elif command -v paplay >/dev/null 2>&1; then
    paplay "${file}" >/dev/null 2>&1 || true
  elif command -v canberra-gtk-play >/dev/null 2>&1; then
    canberra-gtk-play -f "${file}" >/dev/null 2>&1 || true
  elif command -v ffplay >/dev/null 2>&1; then
    ffplay -nodisp -autoexit -loglevel quiet "${file}" >/dev/null 2>&1 || true
  fi
}

# Play the success/failure sound (if enabled) based on the exit status.  Exit
# codes 0 (a step succeeded) and 12 (up to date) count as success; everything
# else counts as failure.
on_exit() {
  local status=$?
  case "${status}" in
    0|12)
      if [ "${play_success}" = 1 ]; then
        play_sound "${SUCCESS_SOUND}"
      fi
      ;;
    *)
      if [ "${play_failure}" = 1 ]; then
        play_sound "${FAILURE_SOUND}"
      fi
      ;;
  esac
}

play_success=0
play_failure=0
positional=()

# Separate optional flags from positional arguments.  Flags may appear in any
# position.
while [ $# -ge 1 ]; do
  case "$1" in
    --sound-success)
      # Play a sound when the tool exits successfully.
      play_success=1
      ;;
    --sound-failure)
      # Play a sound when the tool exits with a failure (e.g. a conflict).
      play_failure=1
      ;;
    -*)
      echo "Unknown option: $1"
      exit 11
      ;;
    *)
      positional+=("$1")
      ;;
  esac
  shift
done

set -- "${positional[@]}"

trap on_exit EXIT

if [ $# -lt 1 ]; then
  echo "Expecting at least one argument, the branch to rebase onto."
  exit 1
fi

target_ref="$1"
shift

n=1

if [ $# -ge 1 ]; then
  n=$1
  shift
fi


if [ $# -ge 1 ]; then
  echo "Unexpected extra arguments: $*"
  exit 11
fi

echo "Using jumps of $n commit(s)"

# Find merge base of current HEAD and target branch.
merge_base=$(git merge-base HEAD "${target_ref}")

# Only walk the target branch's first-parent line.  When the target branch
# periodically merges another branch, this steps over the target's own commits
# and the merge commits, treating each merge as a single step rather than
# descending into every merged-in commit.
num_commits=$(git rev-list --first-parent --reverse "${merge_base}..${target_ref}" | wc -l)

if [ "${num_commits}" -eq 0 ]; then
  echo "Up to date"
  exit 12
fi

# Find first commit after merge base on the target branch.
first_commit=$(git rev-list --first-parent --reverse "${merge_base}..${target_ref}" | head -n 1)
next_commit=$(git rev-list --first-parent --reverse "${merge_base}..${target_ref}" | head -n "$n" | tail -n 1)

section_break
echo "Rebase step"
echo "  Remaining upstream commits: ${num_commits}"
echo "  Requested step size: ${n}"
echo "  Last successful upstream commit:"
echo "    $(print_commit "${merge_base}")"
if [ "${first_commit}" = "${next_commit}" ]; then
  echo "  Rebasing against upstream commit:"
  echo "    $(print_commit "${next_commit}")"
else
  echo "  Rebasing across upstream commits:"
  echo "    first: $(print_commit "${first_commit}")"
  echo "    last:  $(print_commit "${next_commit}")"
fi
section_break

# Rebase on that commit.  Disable git hooks (via an empty hooks path) so that
# tools like pre-commit (https://pre-commit.com/) don't run while replaying
# commits during the rebase.
if ! git -c core.hooksPath=/dev/null rebase "${next_commit}"; then
  section_break
  echo "Manual intervention required"
  echo "  Last successful upstream commit:"
  echo "    $(print_commit "${merge_base}")"
  if [ "${first_commit}" = "${next_commit}" ]; then
    echo "  Conflicting upstream commit:"
    echo "    $(print_commit "${next_commit}")"
    if brought_in=$(print_merge_brings_in "${next_commit}") && [ -n "${brought_in}" ]; then
      echo "  This is a merge commit; it brings in the following commits:"
      echo "${brought_in}"
    fi
  else
    echo "  This rebase attempt covered upstream commits:"
    echo "    first: $(print_commit "${first_commit}")"
    echo "    last:  $(print_commit "${next_commit}")"
    echo "  The exact conflicting upstream commit is within that range."
  fi
  section_break
  exit 13
fi
